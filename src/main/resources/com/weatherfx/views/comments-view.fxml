<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.weatherfx.ui.CommentsController" styleClass="screen">

    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="14">
            <Button text="← Back" styleClass="ghost" onAction="#goBack"/>
            <VBox>
                <Label text="Weather comments" styleClass="screen-title"/>
                <Label fx:id="serverLabel" styleClass="screen-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Refresh" onAction="#refresh"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="18">
            <BorderPane.margin>
                <Insets top="8"/>
            </BorderPane.margin>

            <StackPane styleClass="card" HBox.hgrow="ALWAYS">
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
                    <VBox fx:id="commentsContainer" spacing="10"/>
                </ScrollPane>
                <Label fx:id="messageLabel" styleClass="message" wrapText="true" maxWidth="460"
                       textAlignment="CENTER" mouseTransparent="true"/>
            </StackPane>

            <VBox styleClass="card" spacing="8" prefWidth="340" minWidth="300">
                <Label text="Leave a comment" styleClass="card-title"/>
                <Label text="Name" styleClass="hint"/>
                <TextField fx:id="usernameField" promptText="What should we call you?"/>
                <Label text="Comment" styleClass="hint"/>
                <TextArea fx:id="commentInput" promptText="How's the weather where you are?"
                          wrapText="true" prefRowCount="6" VBox.vgrow="ALWAYS"/>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label fx:id="counterLabel" styleClass="hint"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="postButton" text="Post" styleClass="primary" onAction="#postComment"/>
                </HBox>
                <Label fx:id="formMessage" styleClass="form-error" wrapText="true"/>
                <Label fx:id="locationLabel" styleClass="hint" wrapText="true"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>
